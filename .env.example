# ==== ОБЯЗАТЕЛЬНО ====
# Токен от @BotFather
BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== НЕОБЯЗАТЕЛЬНО ====
# ID каналов через запятую (у каналов ID начинается с -100).
# Пусто = бот принимает заявки везде, где он админ.
ALLOWED_CHATS=

# Твой Telegram ID — кому доступна команда /stats
ADMINS=

# Задержка перед одобрением, секунды. 0 и 0 = принимать мгновенно.
# Если DELAY_MAX больше DELAY_MIN — задержка случайная в этом диапазоне.
DELAY_MIN=0
DELAY_MAX=0

# Писать ли новому подписчику в личку (true/false)
SEND_WELCOME=true
WELCOME_TEXT=Привет, {name}! Твоя заявка в «{chat}» одобрена. Добро пожаловать!

# Куда слать уведомления о принятых (свой ID или ID чата). Пусто = не слать.
LOG_CHAT_ID=

# Файл базы
DB_PATH=bot.db
