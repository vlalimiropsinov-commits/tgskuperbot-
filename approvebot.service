[Unit]
Description=Telegram auto-approve bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/tg-approve-bot
ExecStart=/root/tg-approve-bot/venv/bin/python /root/tg-approve-bot/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/approvebot.log
StandardError=append:/var/log/approvebot.log

[Install]
WantedBy=multi-user.target
